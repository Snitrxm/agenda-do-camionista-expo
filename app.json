{
  "expo": {
    "name": "Agenda do Camionista",
    "slug": "agenda-do-camionista",
    "scheme": "agendadocamionista",
    "version": "1.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "snitram.Agenda-do-Caminhonista-Expo",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSLocationWhenInUseUsageDescription": "O aplicativo precisa acessar sua localização para exibir conteúdo relevante",
        "NSLocationAlwaysUsageDescription": "O aplicativo precisa acessar sua localização para exibir conteúdo relevante",
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "ZP9PM4T396"
    },
    "android": {
      "package": "snitram.agendadocamionista",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/icon.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O aplicativo precisa acessar sua localização para exibir conteúdo relevante"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O aplicativo precisa acessar as suas fotos para anexar ao dia."
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-font",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permite entrar na app com Face ID."
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "locales": {
      "pt": "./locales/pt.json",
      "es": "./locales/es.json"
    }
  }
}